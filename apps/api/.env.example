# Copy to apps/api/.env for `npm run dev` (loaded automatically if present).
# Start the database first: docker compose up -d db

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
DATABASE_URL=postgres://backoffice:backoffice@localhost:5432/backoffice
# The Vite dev server origin (AUTH-21) and plain-HTTP cookies for local development.
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
